{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YuJiDeNote",
  "version": "0.1.0",
  "identifier": "com.yujide.note",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "鱼记得 note",
        "width": 1080,
        "height": 720,
        "minWidth": 780,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
